{
  "name": "clickear-backend",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "test:sqlite": "vitest run --maxWorkers=1 --config vitest.sqlite.config.ts",
    "db:sqlite:schema": "node scripts/build-sqlite-schema.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma && npm run db:sqlite:schema && prisma generate --schema prisma/schema-sqlite.prisma",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.4.0",
    "prisma": "^6.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
