generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ACCESO
// ==========================================

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  name         String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  @@map("users")
}

// ==========================================
// MÓDULO 1: DESPACHO Y TICKETS DE SOPORTE
// ==========================================

model DispatchOrder {
  id                Int      @id @default(autoincrement())
  dispatchCode      String   @map("dispatch_code") @db.VarChar(50)
  dispatchTimestamp DateTime @map("dispatch_timestamp")
  listStatus        String   @map("list_status") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  establishments    Establishment[]
  technicians       DispatchTechnician[]

  @@map("dispatch_orders")
}

model Establishment {
  cue                  String   @id @db.VarChar(20)
  dispatchOrderId      Int?     @map("dispatch_order_id")
  name                 String   @db.VarChar(255)
  department           String?  @db.VarChar(100)
  locality             String?  @db.VarChar(100)
  address              String?  @db.Text
  phone                String?  @db.VarChar(50)
  distanceKm           Decimal? @map("distance_km") @db.Decimal(6, 2)
  directorName         String?  @map("director_name") @db.VarChar(255)
  isSecondaryBuilding  Boolean  @map("is_secondary_building") @default(false)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  // SetNull: al borrar una orden de despacho el establecimiento del catálogo
  // sobrevive y queda disponible para otra orden
  dispatchOrder DispatchOrder? @relation(fields: [dispatchOrderId], references: [id], onDelete: SetNull)
  tickets       Ticket[]
  budgets       Budget[]

  @@map("establishments")
}

model Technician {
  id       Int    @id @default(autoincrement())
  fullName String @map("full_name") @db.VarChar(255)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  dispatchOrders DispatchTechnician[]

  @@map("technicians")
}

// Relación N:M entre órdenes y técnicos
model DispatchTechnician {
  dispatchOrderId Int @map("dispatch_order_id")
  technicianId    Int @map("technician_id")

  dispatchOrder DispatchOrder @relation(fields: [dispatchOrderId], references: [id], onDelete: Cascade)
  technician    Technician    @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@id([dispatchOrderId, technicianId])
  @@map("dispatch_technicians")
}

model Ticket {
  ticketId           BigInt    @id @map("ticket_id")
  establishmentCue   String?   @map("establishment_cue") @db.VarChar(20)
  assignedEmployeeId Int?      @map("assigned_employee_id")
  title              String    @db.Text
  glpiClosedTicket   String?   @map("glpi_closed_ticket") @db.VarChar(100)
  openingTimestamp   DateTime? @map("opening_timestamp") @db.Timestamp()
  status             String    @default("ABIERTO") @db.VarChar(50)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  // Restrict: no se borra un empleado que tenga historial de tickets
  assignedEmployee Employee? @relation(fields: [assignedEmployeeId], references: [id], onDelete: Restrict)
  establishment    Establishment? @relation(fields: [establishmentCue], references: [cue], onDelete: Restrict)
  assignments      TicketAssignment[]
  invoices         Invoice[]

  @@index([assignedEmployeeId])
  @@map("tickets")
}

// Historial de asignación de tickets a empleados (una fila activa por ticket)
model TicketAssignment {
  id         Int       @id @default(autoincrement())
  ticketId   BigInt    @map("ticket_id")
  employeeId Int       @map("employee_id")
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamp()
  releasedAt DateTime? @map("released_at") @db.Timestamp()
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  ticket   Ticket   @relation(fields: [ticketId], references: [ticketId], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([employeeId])
  @@map("ticket_assignments")
}

// ==========================================
// MÓDULO 2: INVENTARIO Y STOCK
// ==========================================

model Supplier {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  contactPhone String?  @map("contact_phone") @db.VarChar(50)
  contactEmail String?  @map("contact_email") @db.VarChar(255)
  website      String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  inventoryItems InventoryItem[]

  @@map("suppliers")
}

model Employee {
  id                Int      @id @default(autoincrement())
  fullName          String   @map("full_name") @db.VarChar(255)
  dniOrFileNumber   String   @unique @map("dni_or_file_number") @db.VarChar(50)
  phone             String?  @db.VarChar(50)
  isActive          Boolean  @map("is_active") @default(true)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  assignments       ItemAssignment[]
  assignedTickets   Ticket[]
  ticketAssignments TicketAssignment[]

  @@map("employees")
}

model InventoryItem {
  id                Int      @id @default(autoincrement())
  supplierId        Int?     @map("supplier_id")
  name              String   @db.VarChar(255)
  description       String?  @db.Text
  availableQuantity Int      @map("available_quantity") @default(0)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  assignments ItemAssignment[] @relation("ItemAssignments")
  budgetLines BudgetLine[] @relation("BudgetLines")

  @@map("inventory_items")
}

model ItemAssignment {
  id               Int       @id @default(autoincrement())
  inventoryItemId  Int       @map("inventory_item_id")
  employeeId       Int       @map("employee_id")
  quantityAssigned Int       @map("quantity_assigned")
  deliveryDate     DateTime  @map("delivery_date") @db.Timestamp()
  returnDate       DateTime? @map("return_date") @db.Timestamp()
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  inventoryItem InventoryItem @relation("ItemAssignments", fields: [inventoryItemId], references: [id], onDelete: Restrict)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("item_assignments")
}

// ==========================================
// MÓDULO 3: FACTURACIÓN ARCA (PREPARACIÓN)
// ==========================================

model Invoice {
  id                Int       @id @default(autoincrement())
  ticketId          BigInt?   @map("ticket_id")
  voucherType       Int       @map("voucher_type")
  docType           Int       @map("doc_type")
  docNumber         String    @map("doc_number") @db.VarChar(20)
  amount            Decimal   @db.Decimal(12, 2)
  cae               String?   @db.VarChar(50)
  caeExpirationDate DateTime? @map("cae_expiration_date") @db.Date()
  status            String    @default("PENDING") @db.VarChar(50)
  errorMessage      String?   @map("error_message") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  ticket Ticket? @relation(fields: [ticketId], references: [ticketId], onDelete: SetNull)

  @@map("invoices")
}

// ==========================================
// MÓDULO 4: PRESUPUESTOS
// ==========================================

model Budget {
  id                Int       @id @default(autoincrement())
  code              String    @map("budget_code") @db.VarChar(20)
  customerName      String    @map("customer_name") @db.VarChar(255)
  establishmentCue  String?   @map("establishment_cue") @db.VarChar(20)
  issueDate         DateTime  @default(now()) @map("issue_date") @db.Timestamp()
  validUntil        DateTime? @map("valid_until") @db.Date()
  status            String    @default("DRAFT") @map("status") @db.VarChar(20)
  notes             String?   @map("notes") @db.Text
  total             Decimal   @db.Decimal(12, 2)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  establishment     Establishment? @relation(fields: [establishmentCue], references: [cue], onDelete: SetNull)
  lines             BudgetLine[]

  @@map("budgets")
}

model BudgetLine {
  id                Int       @id @default(autoincrement())
  budgetId          Int       @map("budget_id")
  inventoryItemId   Int?      @map("inventory_item_id")
  description       String    @db.Text
  quantity          Int       @map("quantity") @default(1)
  unitPrice         Decimal   @map("unit_price") @db.Decimal(12, 2)
  subtotal          Decimal   @map("subtotal") @db.Decimal(12, 2)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull, name: "BudgetLines")

  @@map("budget_lines")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String   @map("action") @db.VarChar(100)
  resource   String?  @map("resource")
  details    Json?    @map("details")
  timestamp  DateTime @default(now()) @map("timestamp") @db.Timestamp()

  @@map("audit_logs")
}

// ==========================================
// SINCRONIZACIÓN (outbox del cliente + cola de sync)
// ==========================================

model PendingSync {
  id        Int      @id @default(autoincrement())
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.VarChar(100)
  operation String   @db.VarChar(20)
  payload   Json
  synced    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp()

  @@map("pending_sync")
}
